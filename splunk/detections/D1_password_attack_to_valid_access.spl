index=black_beacon sourcetype=bb:scenario
event_category=identity event_action=login
| eval fail=if(result="failure",1,0), success=if(result="success",1,0)
| stats sum(fail) as failures sum(success) as successes
        max(eval(if(result="failure",_time,null()))) as last_failure
        min(eval(if(result="success",_time,null()))) as first_success
        by user src_ip
| where failures>=8 AND successes>=1
    AND first_success>=last_failure
    AND (first_success-last_failure)<=900
| eval gap_seconds=first_success-last_failure
| convert ctime(last_failure) ctime(first_success)
